# Estate Value Index Configuration
# Copy this file to .env and fill in your values.
# Every key must be a field of estate_value_index.utils.settings.Settings; unknown keys are an error.

# ==============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# ==============================================================================

# GCP Core Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-north1

# BigQuery Configuration
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET_RAW=booli_raw
BIGQUERY_TABLE_LISTINGS=listings

# GCS Configuration
GCS_BUCKET=your-gcs-bucket

# ==============================================================================
# OPTIONAL ENVIRONMENT VARIABLES (with defaults)
# ==============================================================================

# Data Source Configuration
DATA_SOURCE=bigquery

# Signed Booli API ingestion
# INGESTION_MIN_VALIDATION_RATE=0.5
# BOOLI_API_CALLER_ID=your-booli-caller-id
# BOOLI_API_PRIVATE_KEY=your-booli-private-key

# Flags
GCS_ENABLED=false
# MAX_MEDIAN_APE_THRESHOLD=0.08
